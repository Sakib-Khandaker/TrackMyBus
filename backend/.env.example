# PostgreSQL connection used by docker-compose.yml
DATABASE_URL=postgresql+psycopg://locatex:locatex_dev_password@localhost:5432/locatex

# Generate a long random value for real deployments.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# JSON list is required for pydantic-settings list parsing.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
